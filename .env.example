COMPOSE_PROJECT_NAME=odoo
ODOO_DOMAIN=erp.example.com
ACME_EMAIL=admin@example.com
# Fecha fija; revisar actualizaciones de seguridad y probar antes de cambiar.
ODOO_IMAGE=odoo:19.0-20260926
POSTGRES_IMAGE=postgres:16-bookworm
CADDY_IMAGE=caddy:2-alpine
# Ajuste inicial: servidor con 2 CPU, 4 GB RAM y pocos usuarios simultáneos.
APP_WORKERS=2
ODOO_MEMORY_LIMIT=2304m
APP_MEMORY_SOFT=536870912
APP_MEMORY_HARD=671088640
