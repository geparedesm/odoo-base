COMPOSE_PROJECT_NAME=odoo
ODOO_DOMAIN=erp.example.com
ACME_EMAIL=admin@example.com
# Fixed release date; review security updates and test before changing it.
ODOO_IMAGE=odoo:19.0-20260926
POSTGRES_IMAGE=postgres:16-bookworm
CADDY_IMAGE=caddy:2-alpine
# Initial sizing: 2 CPUs, 4 GB RAM, and a few concurrent users.
APP_WORKERS=2
ODOO_MEMORY_LIMIT=2304m
APP_MEMORY_SOFT=536870912
APP_MEMORY_HARD=671088640
